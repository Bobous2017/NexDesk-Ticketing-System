@model List<NexDesk.Web.Models.TicketVm>
@{
    ViewData["Title"] = "Tickets";
}

<div class="topbar">
    <div class="topbar-main">
        <h2>Tickets</h2>
    </div>
    <div class="top-actions-grid">
        <div class="search-wrap">
            <input type="text" id="ticketSearch" placeholder="Search title or description" class="search-input" />
        </div>
        <div class="filter-wrap">
            <select id="statusFilter" class="filter-select">
                <option value="">All statuses</option>
                <option value="open">Open</option>
                <option value="progress">In Progress</option>
                <option value="resolved">Resolved</option>
                <option value="closed">Closed</option>
            </select>
            <select id="deptFilter" class="filter-select">
                <option value="">All departments</option>
                <option value="hardware">Hardware</option>
                <option value="software">Software</option>
                <option value="network">Network</option>
            </select>
        </div>
        @if (User.FindFirst("PermissionLevel")?.Value == "3")
        {
            <a class="btn primary full-width" asp-action="Create">+ New Ticket</a>
        }
    </div>
</div>

<div class="tickets-container">
    <!-- Desktop Table View -->
    <div class="card tickets-table-wrapper">
        <table class="tickets-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Assigned</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr class="no-results">
                        <td colspan="7" style="text-align: center; padding: 20px; color: var(--muted);">
                            No tickets found
                        </td>
                    </tr>
                }
                @foreach (var t in Model)
                {
                    <tr class="ticket-row">
                        <td class="id-cell">#@t.Id</td>
                        <td class="title-cell">@t.Title</td>
                        <td class="category-cell">@t.CategoryName</td>
                        <td class="priority-cell">
                            <span class="badge @(t.PriorityName?.ToLower() ?? "low")">
                                @t.PriorityName
                            </span>
                        </td>
                        <td class="status-cell">
                            <span class="badge @(t.StatusName?.ToLower() ?? "open")">
                                @t.StatusName
                            </span>
                        </td>
                        <td class="assigned-cell">@t.AssignedToName</td>
                        <td class="actions-cell">
                             <a class="btn btn-sm" asp-action="Details" asp-route-id="@t.Id">View</a>
                            <a class="btn btn-sm" asp-action="Update" asp-route-id="@t.Id">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile Card View -->
    <div class="tickets-mobile-list">
        @if (Model.Count == 0)
        {
            <div class="card" style="text-align: center; padding: 20px; color: var(--muted);">
                No tickets found
            </div>
        }
        @foreach (var t in Model)
        {
            <div class="ticket-mobile-card">
                <div class="ticket-card-id">#@t.Id</div>
                <h3 class="ticket-card-title">@t.Title</h3>
                @if (!string.IsNullOrEmpty(t.Description))
                {
                    <p class="ticket-card-desc">@t.Description</p>
                }

                <div class="ticket-card-due">
                    @if (t.DueDate.HasValue)
                    {
                        var diff = (t.DueDate.Value.Date - DateTime.Now.Date).Days;
                        if (diff > 0)
                        {
                            <span>@diff days left</span>
                        }
                        else if (diff == 0)
                        {
                            <span class="due-today">Due today</span>
                        }
                        else
                        {
                            <span class="overdue">Overdue by @Math.Abs(diff) day(s)</span>
                        }
                    }
                    else
                    {
                        <span class="not-set">No due date</span>
                    }
                </div>

                <div class="ticket-card-meta-row">
                    <div class="meta-section">
                        <span class="meta-label">@t.CategoryName</span>
                    </div>
                    <div class="meta-badges">
                        <span class="badge @(t.PriorityName?.ToLower() ?? "low")">@t.PriorityName</span>
                        <span class="badge @(t.StatusName?.ToLower() ?? "open")">@t.StatusName</span>
                    </div>
                </div>

                <div class="ticket-card-meta-row">
                    <div class="meta-section">
                        <span class="meta-label">@t.DepartmentName</span>
                    </div>
                    <div class="meta-section">
                         <span class="meta-value">@t.AssignedToName</span>
                    </div>
                </div>

                <div class="ticket-card-actions">
                    <a class="btn btn-mobile-block" asp-action="Details" asp-route-id="@t.Id">View</a>
                    <a class="btn btn-mobile-block warn" asp-action="Update" asp-route-id="@t.Id">Edit</a>
                </div>
            </div>
        }
    </div>
</div>