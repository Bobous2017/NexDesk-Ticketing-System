@model NexDesk.Web.Models.DashboardVm
@using System.Text.Json
@using NexDesk.Domain.AuthHelper
@using NexDesk.Web.Controllers.Auth

@{
    Layout = null;
    ViewData["Title"] = "Home Page";
}

<!-- Min Profil button with icon -->
@{
    var userName = User.Identity?.Name ?? "User";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
    var userInitials = "";
    if (!string.IsNullOrEmpty(userName))
    {
        var parts = userName.Split(' ');
        if (parts.Length >= 2)
            userInitials = $"{parts[0][0]}{parts[1][0]}".ToUpper();
        else if (userName.Length >= 2)
            userInitials = userName.Substring(0, 2).ToUpper();
        else
            userInitials = userName.ToUpper();
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>NexDesk — Admin & Support Panel</title>

    <!-- Preconnect to external origins -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://api.qrserver.com" crossorigin />

    <!-- Critical CSS first -->
    <link rel="stylesheet" href="~/css/DashboardAdmin.css" />
    <link rel="stylesheet" href="~/css/feedbackToast.css" />
    <link rel="stylesheet" href="~/css/chatbot.css" />

    <!-- Font Awesome loaded async to avoid render blocking -->
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" /></noscript>

    <!-- Tooltip JS is critical, keep sync -->
    <script src="~/js/tooltip.js"></script>
</head>
<body>
    <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
        <i class="fas fa-bars"></i>
    </button>
    <div class="mobile-menu-overlay" id="mobileMenuOverlay"></div>

    <div class="layout">
        <div class="sidebar-wrapper" style="position: relative;">
            <button id="collapseArrowBtn" class="collapse-toggle" aria-label="Toggle sidebar">
                <i class="fas fa-chevron-left"></i>
            </button>

            <aside class="sidebar" id="mobileSidebar">
                <div class="brand">
                    <img src="~/img/nexdesk_logo_nobg.png" alt="NexDesk logo" aria-label="NexDesk logo" class="brand-logo"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />
                    <div class="brand-badge" style="display:none;">N</div>
                    <div>
                        <h1>NexDesk</h1>
                        <p>Admin & Support Panel</p>
                    </div>
                </div>

                <nav class="nav" aria-label="Main navigation">
                    <button class="active" data-view="dashboard" data-tooltip="Dashboard">
                        <i class="fas fa-tachometer-alt"></i><span class="nav-text">Dashboard</span>
                    </button>
                    <button data-view="tickets" data-tooltip="Tickets">
                        <i class="fas fa-ticket-alt"></i><span class="nav-text">Tickets</span>
                    </button>
                    <button data-view="tasks" data-tooltip="Tasks">
                        <i class="fas fa-tasks"></i><span class="nav-text">Tasks</span>
                    </button>
                    <button style="display:none" data-view="ticketDetail" data-tooltip="Ticket Detail">
                        <i class="fas fa-receipt"></i><span class="nav-text">Ticket Detail</span>
                    </button>
                    @if (User.FindFirst("PermissionLevel")?.Value == "3")
                    {
                        <button data-view="qrList" data-tooltip="Reports">
                            <i class="fas fa-qrcode"></i><span class="nav-text">Reports</span>
                        </button>
                    }
                    <button style="display:none" data-view="qrDetail" data-tooltip="QR Detail Page">
                        <i class="fas fa-info-circle"></i><span class="nav-text">QR Detail Page</span>
                    </button>
                    <button data-view="notifications" data-tooltip="Notifications" style="position:relative;">
                        <i class="fas fa-bell"></i><span class="nav-text">Notifications</span>
                        <span id="notifBadge" class="notif-badge" style="display:none;">0</span>
                    </button>
                    @if (User.FindFirst("PermissionLevel")?.Value == "3")
                    {
                        <button data-view="lookup" data-tooltip="Lookups">
                            <i class="fas fa-search"></i><span class="nav-text">Lookups</span>
                        </button>
                    }
                    <button data-view="comment" data-tooltip="Comments">
                        <i class="fas fa-comment-dots"></i><span class="nav-text">Comments</span>
                    </button>
                    <button data-view="history" data-tooltip="History">
                        <i class="fas fa-history"></i><span class="nav-text">History</span>
                    </button>
                    <button data-view="settings" data-tooltip="Settings">
                        <i class="fas fa-cog"></i><span class="nav-text">Settings</span>
                    </button>

                    @if (User.FindFirst("PermissionLevel")?.Value == "3")
                    {
                        <button data-view="workload" data-tooltip="Workload">
                            <i class="fas fa-chart-bar"></i>
                            <span class="nav-text">Workload</span>
                        </button>
                    }
                </nav>


                <div class="sidebar-footer">
                    <div class="user-info" onclick="openUserDetail(loggedInUserId)">
                        <div class="user-avatar">
                            <div class="avatar-initials">@userInitials</div>
                        </div>
                        <div class="user-details">
                            <div class="user-greeting">
                                <span class="user-name">Hi, @User.Identity?.Name</span>
                            </div>
                            <div class="user-role-badge">
                                <i class="fas fa-shield-alt"></i>
                                <span>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                            </div>
                        </div>
                    </div>

                    <form id="logoutForm" asp-controller="Login" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="button" class="btn-logout" onclick="document.getElementById('confirmOverlay').style.display='block'">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                </div>
            </aside>
        </div>
        <main class="main" role="main">
            <div class="topbar">
                <div>
                    <h2 id="topbarTitle">NexDesk Panel</h2>
                    <p id="topbarDesc">Dashboard — Here you can see a list of recent tickets and an overview of statuses.</p>
                </div>

                @* Search Everything *@
                <div style="position:relative; flex:1; width:100%;">
                    <input id="globalSearch" class="input" placeholder="🔍 Search..."
                           oninput="renderGlobalSearch(this.value)" />
                    <div id="globalSearchResults" style="display:none; position:absolute; top:110%; left:0; right:0;
                          background:var(--panel,#111a2e); border:1px solid #243251; border-radius:8px;
                          z-index:999; max-height:250px; overflow-y:auto;"></div>
                </div>

                <div class="top-actions">
                    <button class="btn" onclick="location.reload()" data-tooltip="btn-refresh">Refresh</button>
                </div>
            </div>
            @* Statuses *@
            <section id="dashboard" class="view active">
                <div class="stats">
                    <div class="card" data-tooltip="stat-open"><div class="stat-label">Open Tickets</div><div class="stat-value" id="statOpen">0</div></div>
                    <div class="card" data-tooltip="stat-progress"><div class="stat-label">In Progress</div><div class="stat-value" id="statProgress">0</div></div>
                    <div class="card" data-tooltip="stat-resolved"><div class="stat-label">Resolved</div><div class="stat-value" id="statResolved">0</div></div>
                    <div class="card" data-tooltip="stat-total"><div class="stat-label">Total Tickets</div><div class="stat-value" id="statTasks">0</div></div>
                </div>

                <div class="grid" style="grid-template-columns: 1fr 1fr 1fr;">
                    <div class="card">
                        <div class="section-head">
                            <div>
                                <h3>Recent Tickets</h3>
                                <div class="muted">Latest incoming support cases</div>
                            </div>
                        </div>
                        <div id="recentTickets" class="list"></div>
                    </div>

                    <div class="card">
                        <div class="section-head" style="justify-content:flex-start;">
                            <div>
                                <h3>Activity Feed</h3>
                                <div class="muted">Latest system activity</div>
                            </div>
                        </div>
                        <div id="activityFeed" class="list" style="max-height:630px; overflow-y:auto;"></div>
                    </div>

                    <div class="card">
                        <div class="section-head">
                            <div>
                                <h3>Quick Overview</h3>
                                <div class="muted">Current workload snapshot</div>
                            </div>
                        </div>
                        <div id="quickOverview" class="list"></div>
                    </div>
                </div>
            </section>

            <section id="tickets" class="view">
                <div class="card">
                    <div class="section-head">
                        <div>
                            <h3>Tickets</h3>
                            <div class="muted">Admin can manage all tickets. Supporter can work on assigned tickets.</div>
                        </div>
                        <div class="actions">
                            <button class="btn primary" data-tooltip="btn-newTicket" onclick="openCreateTicket()">New Ticket</button>
                        </div>
                    </div>

                    <div class="toolbar">
                        <input id="ticketSearch" data-tooltip="ticket-search" placeholder="Search title, description or user" oninput="renderTickets()" />
                        <select id="ticketStatusFilter" data-tooltip="ticket-filter-status" onchange="renderTickets()"><option value="">All statuses</option></select>
                        <select id="ticketDepartmentFilter" data-tooltip="ticket-filter-department" onchange="renderTickets()"><option value="">All departments</option></select>
                        <select id="ticketUserFilter" data-tooltip="ticket-filter-user" onchange="renderTickets()"><option value="">All users</option></select>
                    </div>

                    <div class="tickets-table-wrapper" style="overflow:auto;">
                        <table class="tickets-table">
                            <thead>
                                <tr>
                                    <th data-tooltip="ticket-col-id">ID</th>
                                    <th data-tooltip="ticket-col-title">Title</th>
                                    <th data-tooltip="ticket-col-category">Category</th>
                                    <th data-tooltip="ticket-col-priority">Priority</th>
                                    <th data-tooltip="ticket-col-status">Status</th>
                                    <th data-tooltip="ticket-col-department">Department</th>
                                    <th data-tooltip="ticket-col-assigned">Assigned</th>
                                    <th data-tooltip="">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="ticketTableBody"></tbody>
                        </table>
                    </div>

                    <div id="ticketMobileList" class="tickets-mobile-list"></div>
                </div>
            </section>

            <section id="tasks" class="view">
                <div class="grid" style="grid-template-columns:@(User.FindFirst("PermissionLevel")?.Value == "3") ? " 1.5fr .95fr" : "1fr" );">
                    @if (User.FindFirst("PermissionLevel")?.Value == "3")
                    {
                        <div class="card">
                            <div class="section-head">
                                <div>
                                    <h3>Task Assignment</h3>
                                    <div class="muted">Admin creates tasks. Supporter sees and works on assigned tasks.</div>
                                </div>
                            </div>
                            <form class="form-grid" onsubmit="createTask(event)">
                                <select id="taskTicketId" required></select>
                                <select id="taskAssignedUserId" required></select>
                                <input id="taskTitle" placeholder="Task title" required />
                                <select id="taskStatus" required></select>
                                <textarea id="taskDescription" class="full" placeholder="Task description" required></textarea>
                                <input id="taskDueDate" type="datetime-local" />
                                <div class="actions full"><button class="btn primary" data-tooltip="btn-createTask" type="submit">Create Task</button></div>
                            </form>
                        </div>
                    }

                    <div class="card">
                        <div class="section-head">
                            <div>
                                <h3>Current Tasks</h3>

                                <div class="muted">@(User.FindFirst("PermissionLevel")?.Value == "3" ? "Open and active work items" : "Tasks assigned to you")</div>
                            </div>
                        </div>
                        <div id="taskList" class="list" style="max-height:640px; overflow-y:auto;"></div>
                    </div>
                </div>
            </section>

            <section id="ticketDetail" class="view">
                <div class="grid">
                    <div class="card">
                        <div class="section-head">
                            <div>
                                <h3>Ticket Detail</h3>
                                <div class="muted">Supporter finishes work by replying inside the ticket.</div>
                            </div>
                            <select id="ticketDetailSelect" onchange="renderTicketDetail()"></select>
                        </div>
                        <div id="ticketDetailBox" class="ticket-detail-box"></div>
                    </div>

                    <div class="card">
                        <div class="section-head">
                            <div>
                                <h3 id="ticketDetailSideTitle">Support Reply / Finish Work</h3>
                                <div id="ticketDetailSideDesc" class="muted">When confirmed, the system generates report + QR from the ticket reply.</div>
                            </div>
                        </div>
                        <div id="ticketDetailSidePanel"></div>
                    </div>
                </div>
            </section>

            <section id="qrList" class="view">
                <div class="card">
                    <div class="section-head">
                        <div>
                            <h3>Reports</h3>
                            <div class="muted">Admin can browse all generated QR codes and choose one to scan/open.</div>
                        </div>
                    </div>
                    <div id="qrListBox" class="list"></div>
                </div>
            </section>

            <section id="qrDetail" class="view">
                <div class="card">
                    <div class="section-head">
                        <div>
                            <h3>QR Detail Page</h3>
                            <div class="muted">This represents the page opened after MAUI scan and swipe confirmation.</div>
                        </div>
                        <select id="qrDetailSelect" onchange="renderQrDetail()"></select>
                    </div>
                    <div id="qrDetailBox" class="ticket-detail-box"></div>
                </div>
            </section>

            <section id="notifications" class="view">
                <div class="card">
                    <div class="section-head">
                        <div>
                            <h3>Notifications</h3>
                            <div class="muted">Assignment, updates and reminders</div>
                        </div>
                        <button class="btn primary" data-tooltip="btn-markAllRead" onclick="markAllAsRead()">Mark all as read</button>
                    </div>
                    <div id="notificationList" class="list"></div>
                </div>
            </section>

            <section id="lookup" class="view">
                <div class="grid">
                    <div class="card" data-tooltip="lookup-categories"><div class="section-head"><h3>Ticket Categories</h3></div><div id="categoryList" class="list"></div></div>
                    <div class="card" data-tooltip="lookup-departments"><div class="section-head"><h3>Departments</h3></div><div id="departmentList" class="list"></div></div>
                    <div class="card" data-tooltip="lookup-priorities"><div class="section-head"><h3>Priorities</h3></div><div id="priorityList" class="list"></div></div>
                    <div class="card" data-tooltip="lookup-statuses"><div class="section-head"><h3>Statuses</h3></div><div id="statusList" class="list"></div></div>
                </div>
            </section>

            <section id="comment" class="view">
                <div class="card">
                    <div class="section-head">
                        <div>
                            <h3>Comments</h3>
                            <div class="muted">Comments and replies for tickets</div>
                        </div>
                    </div>
                    <div id="commentList" class="list"></div>
                </div>
            </section>

            <section id="history" class="view">
                <div class="card">
                    <div class="section-head">
                        <div>
                            <h3>History</h3>
                            <div class="muted">Ticket activity history</div>
                        </div>
                    </div>
                    <div id="historyList" class="list"></div>
                </div>
            </section>

            @* Settings.cshtml renders inside the dashboard without any changes *@
            <section id="settings" class="view">
                <div class="card">
                    <div class="section-head">
                        <h3>Settings</h3>
                        <div class="muted">Password and account settings</div>
                    </div>
                    <iframe id="settingsIframe"
                            src="/Settings/Index"
                            style="width:100%; height:auto; min-height:500px; border:none; border-radius:8px; overflow:hidden;">
                    </iframe>
                </div>
            </section>
            @* User Profil *@
            <section id="userDetail" class="view">
                <div class="card">
                    <div class="section-head">
                        <div>
                            <h3 id="userDetailTitle">User Profile</h3>
                            <div class="muted">Detailed overview of user activity and account</div>
                        </div>
                        <button class="btn" data-tooltip="btn-tilbage" onclick="goBackFromUserDetail()">← Back</button>
                        <button class="btn primary" id="exportPdfBtn" data-tooltip="btn-exportPdf">⬇ Export PDF</button>
                    </div>
                    <div id="userDetailContent">
                        <p style="color:var(--muted)">Loading...</p>
                    </div>
                </div>
            </section>

            @* SUpporter  Workload   *@
            @if (User.FindFirst("PermissionLevel")?.Value == "3")
            {
                <section id="workload" class="view">
                    <div class="card">
                        <div class="section-head">
                            <div>
                                <h3>Supporter Workload</h3>
                                <div class="muted">Overview of all supporters' workload</div>
                            </div>
                        </div>
                        <div id="workloadContent"></div>
                    </div>
                </section>
            }
        </main>

        @* Add tPop up Ticket for CRUD *@
        <div id="modalOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:100;">
            <div style="background:var(--card,#1e1e2e); border-radius:12px; padding:2rem; width:500px; margin:5% auto; position:relative;">
                <h3 id="modalTitle">Create Ticket</h3>
                <div class="form-grid" style="margin-top:1rem;">
                    <input type="hidden" id="editTicketId" />
                    <div><label data-tooltip="modal-title">Title</label><input id="fTitle" class="input" placeholder="Ticket title" /></div>
                    <div><label data-tooltip="modal-desc">Description</label><textarea id="fDesc" class="input" placeholder="Description"></textarea></div>
                    <div><label data-tooltip="modal-category">Category</label><select id="fCategory" class="input"></select></div>
                    <div><label data-tooltip="modal-priority">Priority</label><select id="fPriority" class="input"></select></div>
                    <div><label data-tooltip="modal-status">Status</label><select id="fStatus" class="input"></select></div>
                    <div><label data-tooltip="modal-department">Department</label><select id="fDepartment" class="input"></select></div>
                    <div><label data-tooltip="modal-assign">Assign To</label><select id="fAssign" class="input"></select></div>
                    <div><label data-tooltip="modal-dueDate">Due Date</label><input id="fDueDate" class="input" type="datetime-local" /></div>
                </div>
                <div class="actions" style="margin-top:1.5rem;">
                    <button class="btn" data-tooltip="btn-cancelModal" onclick="closeModal()">Cancel</button>
                    <button class="btn primary" data-tooltip="btn-saveTicket" onclick="saveTicket()">Save</button>
                </div>
            </div>
        </div>

        @* confirm log out *@
        <div id="confirmOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:9998;">
            <div style="background:var(--panel,#111a2e); border-radius:12px; padding:2rem; width:360px; margin:15% auto; text-align:center;">
                <h3 style="margin-bottom:0.5rem;">Log out?</h3>
                <p style="color:var(--muted); margin-bottom:1.5rem;">Are you sure you want to log out?</p>
                <div style="display:flex; gap:1rem; justify-content:center;">
                    <button class="btn" onclick="document.getElementById('confirmOverlay').style.display='none'">No</button>
                    <button class="btn" data-tooltip="btn-logout" style="background:var(--danger,#ff6b6b); color:#fff;" onclick="doLogout()">Yes, log out</button>
                </div>
            </div>
        </div>

        @* Generic confirm - for reuse *@
        <div id="genericConfirmOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:10000;">
            <div style="background:var(--panel,#111a2e); border-radius:12px; padding:2rem; width:360px; margin:15% auto; text-align:center;">
                <h3 style="margin-bottom:0.5rem;">Confirm</h3>
                <p id="confirmMessage" style="color:var(--muted); margin-bottom:1.5rem;"></p>
                <div style="display:flex; gap:1rem; justify-content:center;">
                    <button class="btn" onclick="document.getElementById('genericConfirmOverlay').style.display='none'">No</button>
                    <button id="confirmYesBtn" class="btn" style="background:var(--danger,#ff6b6b); color:#fff;">Yes</button>
                </div>
            </div>
        </div>

        @* Task Resolve Note *@
        <div id="taskResolveOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:10000;">
            <div style="background:var(--panel,#111a2e); border-radius:12px; padding:2rem; width:420px; margin:15% auto; text-align:center;">
                <h3 style="margin-bottom:0.5rem;">Beskriv løsningen</h3>
                <p style="color:var(--muted); margin-bottom:1rem;">Hvad blev udført på denne task?</p>
                <textarea id="taskResolveNote" class="input" style="width:100%; min-height:100px; margin-bottom:1rem;" placeholder="Beskriv hvad der blev udført..."></textarea>
                <div style="display:flex; gap:1rem; justify-content:center;">
                    <button class="btn" onclick="document.getElementById('taskResolveOverlay').style.display='none'">Annuller</button>
                    <button id="taskResolveGemBtn" class="btn" style="background:#2563eb; color:#fff;">Gem</button>
                </div>
            </div>
        </div>
    </div>

    @* Chatbot HTML widget *@
    <!-- INDEPENDENT CHATBOT MODULE (Collapsible, multi-language dictionary) -->
    @* ── NexDesk  Chatbot ── *@
    <div class="nexdesk-chatbot">
        <div id="chatCollapsedBtn" class="chat-toggle-btn">
            <svg viewBox="0 0 24 24" width="28" height="28" stroke="none" fill="white">
                <path d="M20 2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h4l4 4 4-4h4c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z" />
            </svg>
        </div>
        <div id="chatWindow" class="chat-window collapsed">
            <div class="chat-header" id="chatHeaderToggle">
                <h3>🤖 NexDesk Chat • Support</h3>
                <div class="chat-header-actions">

                    <!--  Language switcher — stops click from collapsing chat -->
                    <div class="chat-lang-switcher" onclick="event.stopPropagation()">
                        <button onclick="setLang('da')" title="Dansk">
                            <img src="https://flagcdn.com/16x12/dk.png" alt="DK"> DA
                        </button>
                        <button onclick="setLang('en')" title="English">
                            <img src="https://flagcdn.com/16x12/gb.png" alt="EN"> EN
                        </button>
                        <button onclick="setLang('fr')" title="Français">
                            <img src="https://flagcdn.com/16x12/fr.png" alt="FR"> FR
                        </button>
                    </div>

                    <div class="collapse-icon" id="minimizeChatBtn">–</div>
                </div>
            </div>
            <div class="chat-messages" id="chatMessages"></div>
            <div class="chat-input-area">
                <input type="text" id="chatInput" placeholder="Type your message..." autocomplete="off" />
                <button class="send-btn" id="sendMsgBtn">➤</button>
            </div>
        </div>
    </div>
 
    <div id="toastContainer"></div>
    <script src="~/js/navbarCollapse.js" ></script>
    <script src="~/js/dictionaryNexDeskAI.js"></script>
    <script src="~/js/chatbot.js"></script>
    <script src="~/js/feedbackToast.js"></script>
    <script src="~/js/ticket.js"></script>
    <script src="~/js/userDetail.js" asp-append-version="true"></script>
    <script src="~/js/renderingUI/renderDashboard.js"></script>
    <script src="~/js/renderingUI/renderComments.js"></script>
    <script src="~/js/renderingUI/renderHistory.js"></script>
    <script src="~/js/renderingUI/renderLookups.js"></script>
    <script src="~/js/renderingUI/renderNotifications.js"></script>
    <script src="~/js/renderingUI/renderQrDetail.js" asp-append-version="true"></script>
    <script src="~/js/renderingUI/renderQrList.js"></script>
    <script src="~/js/renderingUI/renderTasks.js" asp-append-version="true"></script>
    <script src="~/js/renderingUI/renderTicketDetail.js" asp-append-version="true"></script>
    <script src="~/js/renderingUI/renderTickets.js"></script>
    <script src="~/js/globalSearch.js"></script>

    <script>

        window.App = {
            dashboardVm: null,
            apiBase: '@ViewData["ApiBaseUrl"]'
        };
        // Tell parent to resize iframe to fit content
        window.addEventListener('load', () => {
            parent.document.querySelector('iframe').style.height =
                document.body.scrollHeight + 'px';
        });


        //****************************************************************** Global variables - Can access from js files *******************************************************************
        // Base URL for all API calls — injected from server-side ViewData
        const apiBase = '@ViewData["ApiBaseUrl"]';
        const loggedInUserId = @(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");  // Logged-in user's ID — extracted from JWT NameIdentifier claim, defaults to 0 if not found
        const isAdmin = @Json.Serialize(User.FindFirst("PermissionLevel") != null && User.FindFirst("PermissionLevel").Value == "3"); // Boolean flag — true if logged-in user has PermissionLevel 3 (Administrator)

        // Current logged-in user object — built from JWT claims for use across all JS files
        const currentAdminUser = {
            id: loggedInUserId,// User ID — same as loggedInUserId, used for API calls that require the caller's ID
            firstName: "@(User.Identity?.Name?.Split(' ')[0] ?? "")", // First name — extracted from the first part of the Identity Name claim
            lastName: "@(User.Identity?.Name?.Split(' ').Length > 1 ? User.Identity.Name.Split(' ')[1] : "")",// Last name  extracted from the second part of the Identity Name claim, empty string if only one name
            userName: "@User.Identity?.Name", // Full username — taken directly from the Identity Name claim
            roleName: "@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Administrator")",// Role name — extracted from the Role claim, defaults to Administrator if not found
            email: "@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "nexdesk2017@gmail.com")"// Email — extracted from the Email claim, defaults to NexDesk system email if not found
        };


        // Load  renderDashboard  with  ticketStatuses and  recents tickets
        const dashboardVm = @Html.Raw(JsonSerializer.Serialize(Model, new JsonSerializerOptions
        {
                        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        }));
        const api = {
          tickets: '/api/Tickets',
          ticketCategories: '/api/TicketCategories',
          ticketDepartments: '/api/TicketDepartments',
          ticketPriorities: '/api/TicketPriorities',
          ticketStatuses: '/api/TicketStatuses',
          tasks: '/api/Tasks',
          reports: '/api/Reports',
          qrCodes: '/api/QrCodes',
          notifications: '/api/Notifications',
          history: '/api/History',
          comments: '/api/Comments',
          attachments: '/api/Attachments',
          users: '/api/Users'
        };

        function getVisibleTasks() {
            const tasks = (dashboardVm?.tasks ?? []).filter(t => Number(t?.isActive ?? 1) === 1);
            if (isAdmin) return tasks;

            const myUserId = Number(loggedInUserId || 0);
            return tasks.filter(t => Number(t?.assignedUserId ?? t?.assignedToUserId ?? 0) === myUserId);
        }

        function getVisibleTickets() {
            const tickets = (dashboardVm?.tickets ?? []).filter(t => Number(t?.isActive ?? 1) === 1);
            if (isAdmin) return tickets;

            const myUserId = Number(loggedInUserId || 0);
            const taskTicketIds = new Set(getVisibleTasks().map(t => Number(t?.ticketId ?? 0)));

            return tickets.filter(t => {
                const assignedToUserId = Number(t?.assignedToUserId ?? 0);
                const isUnassigned = assignedToUserId === 0 || !t?.assignedToUserId;
                return assignedToUserId === myUserId || isUnassigned || taskTicketIds.has(Number(t?.id ?? 0));
            });
        }


        function statusBadgeClass(name) {
          const n = (name || '').toLowerCase();
          if (n.includes('open')) return 'open';
          if (n.includes('progress') || n.includes('waiting')) return 'progress';
          if (n.includes('resolved')) return 'resolved';
          if (n.includes('closed')) return 'closed';
          return 'open';
        }
        function priorityBadgeClass(name) {
          const n = (name || '').toLowerCase();
          if (n.includes('extreme') || n.includes('critical')) return 'extreme';
          if (n.includes('high') || n.includes('major')) return 'high';
          if (n.includes('medium') || n.includes('normal')) return 'medium';
          return 'low';
        }


       //  populateFilters Filter
        function populateFilters() {
            document.getElementById('ticketStatusFilter').innerHTML =
                '<option value="">All statuses</option>' +
                (dashboardVm.ticketStatuses ?? []).map(x => `<option value="${x.id}">${x.name}</option>`).join('');

            document.getElementById('ticketDepartmentFilter').innerHTML =
                '<option value="">All departments</option>' +
                (dashboardVm.ticketDepartments ?? []).map(x => `<option value="${x.id}">${x.name}</option>`).join('');

            document.getElementById('ticketUserFilter').innerHTML =
                '<option value="">All users</option>' +
                (dashboardVm.users ?? []).map(u => {
                    const fullName = `${u.firstName ?? ''} ${u.lastName ?? ''}`.trim() || u.userName;
                    return `<option value="${u.id}">${fullName}</option>`;
                }).join('');
        }
        // DropDown  filter in Ticket details, use dashboardVm
        function populateFormSelects() {
            const ticketOptions = (dashboardVm.tickets ?? [])
                .map(x => `<option value="${x.id}">#${x.id} - ${x.title}</option>`).join('');

            const userOptions = (dashboardVm.users ?? [])
                .map(u => {
                    const fullName = `${u.firstName ?? ''} ${u.lastName ?? ''}`.trim();
                    return `<option value="${u.id}">${fullName || u.userName || `User #${u.id}`}</option>`;
                }).join('');

            const taskStatus = document.getElementById('taskStatus');
            if (taskStatus) {
                taskStatus.innerHTML = (dashboardVm.ticketStatuses ?? [])
                    .filter(s => s.name !== 'Closed')
                    .map(s => `<option value="${s.id}">${s.name}</option>`).join('');
            }

            const taskTicketId = document.getElementById('taskTicketId');
            if (taskTicketId) taskTicketId.innerHTML = ticketOptions;

            const taskAssignedUserId = document.getElementById('taskAssignedUserId');
            if (taskAssignedUserId) taskAssignedUserId.innerHTML = userOptions;

            const replyTicketId = document.getElementById('replyTicketId');
            if (replyTicketId) {
                replyTicketId.innerHTML = (dashboardVm.tickets ?? [])
                    .map(x => `<option value="${x.id}">#${x.id} - ${x.title}</option>`).join('');
            }

            const replyUserId = document.getElementById('replyUserId');
            if (replyUserId) {
                replyUserId.innerHTML = (dashboardVm.users ?? []).map(u => {
                    const fullName = `${u.firstName ?? ''} ${u.lastName ?? ''}`.trim();
                    return `<option value="${u.id}">${fullName || u.userName || `User #${u.id}`}</option>`;
                }).join('');
            }

            const ticketDetailSelect = document.getElementById('ticketDetailSelect');
            if (ticketDetailSelect) {
                const savedValue = ticketDetailSelect.value;
                const visibleTickets = getVisibleTickets();
                ticketDetailSelect.innerHTML = visibleTickets
                    .map(x => `<option value="${x.id}">#${x.id} - ${x.title}</option>`).join('');
                if (savedValue) ticketDetailSelect.value = savedValue;
            }

            const qrDetailSelect = document.getElementById('qrDetailSelect');
            if (qrDetailSelect) {
                qrDetailSelect.innerHTML = (dashboardVm.reports ?? [])
                    .map(r => `<option value="${r.id}">Report #${r.id} - Ticket #${r.ticketId}</option>`).join('');
            }
        }

        // view viewDescriptions for pages
         const viewDescriptions = {
            dashboard:    { title: 'Dashboard',      desc: 'Here you can see a list of recent tickets and an overview of statuses.' },
            tickets:      { title: 'Tickets',        desc: 'Search, filter and manage all support tickets.' },
            tasks:        { title: 'Tasks',          desc: 'Create and assign tasks to supporters based on open tickets.' },
            ticketDetail: { title: 'Ticket Details', desc: 'See full details, comments and history for a selected ticket.' },
            qrList:       { title: 'Reports',   desc: 'Browse all generated QR codes from resolved tickets.' },
            qrDetail:     { title: 'QR Details',     desc: 'See report and documentation after MAUI scan and confirmation.' },
            notifications:{ title: 'Notifications',  desc: 'See assignments, updates and reminders for your tickets.' },
            lookup:       { title: 'Lookup Data',    desc: 'Manage categories, departments, priorities and statuses.' },
            comment:      { title: 'Comments',       desc: 'See all comments and replies across tickets.' },
            history:      { title: 'History',        desc: 'See all changes and activities on tickets over time.' },
            settings:     { title: 'Settings',       desc: 'Manage password, users, roles and lookup data.' },
            workload:     { title: 'Workload',       desc: 'Overview of all supporters\' workload.' },
            userDetail:   { title: 'User Profile',   desc: 'Detailed overview of user activity and account.' }
        };

         // renderWorkload() call
        document.querySelectorAll('.nav button').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.nav button').forEach(x => x.classList.remove('active'));
                document.querySelectorAll('.view').forEach(x => x.classList.remove('active'));
                btn.classList.add('active');
                document.getElementById(btn.dataset.view).classList.add('active');

                 // Trigger workload render when workload view is selected
                if (btn.dataset.view === 'workload') renderWorkload();

                // Update topbar
                const view = viewDescriptions[btn.dataset.view];
                if (view) {
                    document.getElementById('topbarTitle').textContent = view.title;
                    document.getElementById('topbarDesc').textContent = view.desc;
                }

                // Update browser URL
                const urlMap = {
                    dashboard: '/Dashboard', tickets: '/home/Tickets', tasks: '/home/Tasks',
                    ticketDetail: '/Ticket-Detail', qrList: '/Qr-List', qrDetail: '/Qr-Detail',
                    notifications: '/Notifications', lookup: '/Lookups', comment: '/Comments',
                    history: '/History', settings: '/home/Settings', workload: '/Workload'
                };
                history.pushState(null, '', urlMap[btn.dataset.view] ?? '/');
                document.title = 'NexDesk - ' + view?.title ?? 'NexDesk';
            });
        });



        //------------------ Session timeout -----------------------------------
                // Change const to let so it can be updated
        let sessionTimeoutSeconds = @(User.FindFirst("SessionTimeoutSeconds")?.Value ?? SessionTimer.SessionTimeoutSeconds.ToString());
        let remaining = sessionTimeoutSeconds + 60;
        let warningShown = false;
        let modal = null;
        let countdownInterval = null; //  Track interval so we can clear it

        // Poll every 30 seconds to check if admin changed the session
        setInterval(async () => {
            try {
                const res = await fetch(`${apiBase}/api/userprofiles/byuser/${loggedInUserId}`);
                const data = await res.json();

                const newTimeout = (data.sessionTimeoutMinutes ?? 2) * 60;

                // Only reset if admin actually changed the value
                if (newTimeout !== sessionTimeoutSeconds) {
                    console.log("Session timeout changed by admin:", newTimeout, "sec");

                    // Update the value
                    sessionTimeoutSeconds = newTimeout;

                    // Reset remaining to new timeout + 60 grace
                    remaining = sessionTimeoutSeconds + 60;

                    // Reset warning so it triggers correctly for new timeout
                    warningShown = false;
                    if (modal) {
                        modal.remove();
                        modal = null;
                    }

                    console.log(" Session updated live — no restart needed");
                }
            } catch (err) {
                console.warn(" Could not fetch session timeout:", err);
            }
        }, 30000); // Check every 30 seconds



        function createWarningModal() {
            // Prevent duplicate modals
            if (modal) modal.remove();

            modal = document.createElement("div");
            modal.style.position = "fixed";
            modal.style.bottom = "20px";
            modal.style.right = "20px";
            modal.style.background = "#dc2626";
            modal.style.color = "white";
            modal.style.padding = "15px";
            modal.style.borderRadius = "8px";
            modal.style.zIndex = "1000";
            modal.innerHTML = `
                Session expires in <span id="countdown">60</span> seconds.
                <button onclick="refreshSession()" style="margin-left:10px;padding:5px 10px;background:white;color:black;border-radius:4px;">
                    Extend
                </button>
            `;
            document.body.appendChild(modal);
        }

        function refreshSession() {
            fetch("/Auth/KeepAlive", { method: "POST" })
                .then(() => {
                    // Step 1 — Remove modal immediately
                    if (modal) {
                        modal.remove();
                        modal = null;
                    }

                    // Step 2 — Reset remaining to FULL timeout + 60 grace
                    remaining = sessionTimeoutSeconds + 60;

                    // Step 3 — Reset warning flag AFTER remaining is set
                    // This was the core bug — flag was reset before remaining was safe
                    warningShown = false;

                    console.log(" Session extended — remaining reset to:", remaining);
                });
        }

        // Main countdown interval
        countdownInterval = setInterval(() => {
            remaining--;

            // Show warning only when remaining hits exactly 60
            // and warning has not been shown yet
            if (remaining <= 60 && !warningShown) {
                createWarningModal();
                warningShown = true;
                console.log(" Session warning shown");
            }

            // Logout when time is fully up
            if (remaining <= 0) {
                clearInterval(countdownInterval);
                window.location.href = "/session-expired";
            }

            // Update countdown number in modal if visible
            const cd = document.getElementById("countdown");
            if (cd) cd.innerText = remaining <= 60 ? remaining : 60;

        }, 1000);

        // ---------------------- Render all UI -----------------------
        function renderAll() {

          populateFilters();
          populateFormSelects();
          renderDashboard();
          renderTickets();
          renderTasks();
          renderTicketDetail();
          renderQrList();
          renderQrDetail();
          renderNotifications();
          renderLookups();
          renderComments();
          renderHistory();
          renderActivityFeed();
          if (typeof updateSidebarUserProfile === 'function') {
            updateSidebarUserProfile();
          }
        }

        renderAll(); // Render all UI

        // Restore view from URL on page load
        const urlToView = {
            '/dashboard': 'dashboard',
            '/home/tickets': 'tickets',
            '/home/tasks': 'tasks',
            '/ticket-detail': 'ticketDetail',
            '/qr-list': 'qrList',
            '/qr-detail': 'qrDetail',
            '/notifications': 'notifications',
            '/lookups': 'lookup',
            '/comments': 'comment',
            '/history': 'history',
            '/home/settings': 'settings',
            '/workload': 'workload'
        };

        const currentPath = window.location.pathname.toLowerCase();
        const targetView = urlToView[currentPath];
        if (targetView) {
            const btn = document.querySelector(`.nav button[data-view="${targetView}"]`);
            if (btn) btn.click();
        }

        // ==================== Mobile Menu Toggle ====================
        const mobileMenuToggle = document.getElementById('mobileMenuToggle');
        const mobileSidebar = document.getElementById('mobileSidebar');
        const mobileMenuOverlay = document.getElementById('mobileMenuOverlay');

        // Toggle mobile menu
        if (mobileMenuToggle) {
            mobileMenuToggle.addEventListener('click', () => {
                if (mobileSidebar) mobileSidebar.classList.toggle('mobile-open');
                if (mobileMenuOverlay) mobileMenuOverlay.classList.toggle('mobile-open');
                mobileMenuToggle.classList.toggle('mobile-open');
            });
        }

        // Close menu when clicking overlay
        if (mobileMenuOverlay) {
            mobileMenuOverlay.addEventListener('click', () => {
                if (mobileSidebar) mobileSidebar.classList.remove('mobile-open');
                mobileMenuOverlay.classList.remove('mobile-open');
                if (mobileMenuToggle) mobileMenuToggle.classList.remove('mobile-open');
            });
        }

        // Close menu when clicking a nav button
        document.querySelectorAll('.nav button').forEach(btn => {
            btn.addEventListener('click', () => {
                if (window.innerWidth <= 768) {
                    if (mobileSidebar) mobileSidebar.classList.remove('mobile-open');
                    if (mobileMenuOverlay) mobileMenuOverlay.classList.remove('mobile-open');
                    if (mobileMenuToggle) mobileMenuToggle.classList.remove('mobile-open');
                }
            });
        });

        // Close menu when clicking user detail
        document.querySelector('.user-info')?.addEventListener('click', () => {
            if (window.innerWidth <= 768) {
                if (mobileSidebar) mobileSidebar.classList.remove('mobile-open');
                if (mobileMenuOverlay) mobileMenuOverlay.classList.remove('mobile-open');
                if (mobileMenuToggle) mobileMenuToggle.classList.remove('mobile-open');
            }
        });

        // Ensure sidebar logo image or other elements don't block clicks in mobile
        document.querySelector('.brand')?.addEventListener('click', () => {
             if (window.innerWidth <= 768) {
                if (mobileSidebar) mobileSidebar.classList.remove('mobile-open');
                if (mobileMenuOverlay) mobileMenuOverlay.classList.remove('mobile-open');
                if (mobileMenuToggle) mobileMenuToggle.classList.remove('mobile-open');
            }
        });

        // Auto-resize iframe based on content height
        const settingsIframe = document.getElementById('settingsIframe');
        if (settingsIframe) {
            settingsIframe.onload = function() {
                try {
                    const iframeDoc = settingsIframe.contentDocument || settingsIframe.contentWindow.document;
                    const height = iframeDoc.documentElement.scrollHeight;
                    settingsIframe.style.height = (height + 20) + 'px';
                } catch (e) {
                    console.log('Could not access iframe content');
                }
            };
        }

    </script>

</body>
</html>

