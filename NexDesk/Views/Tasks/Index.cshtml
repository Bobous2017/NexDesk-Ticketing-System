@model List<NexDesk.Domain.Entities.Task.TicketTask>
@{
    ViewData["Title"] = "Tasks";
}

<div class="topbar">
    <h2>Tasks</h2>
</div>

<div class="card">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Ticket</th>
                <th>Status</th>
                <th>Assigned</th>
                <th>Due Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>#@t.Id</td>
                    <td>@t.Title</td>
                    <td>#@t.TicketId</td>
                    <td>@(t.Status?.Name ?? "-")</td>
                    <td>@(t.AssignedUser != null ? $"{t.AssignedUser.FirstName} {t.AssignedUser.LastName}".Trim() : "Unassigned")</td>
                    <td>@(t.DueDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
