@using NexDesk.Domain.Dtos.UserHandlingDto
@{
    Layout = null;
}
@model ResetPasswordDto

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nulstil adgangskode - NexDesk</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="@Url.Content("~/css/password-reset.css")" />
</head>
<body>
    <div class="reset-card">
        <div class="reset-header">
            <i class="fa-solid fa-key"></i>
            <h1>Nulstil adgangskode</h1>
            <p>Indtast din nye adgangskode og 6-cifret kode</p>
        </div>

        <div class="reset-body">
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Token" />

                <!-- Token Info (optional - show if you want) -->
                @if (!string.IsNullOrEmpty(Model?.Token))
                {
                    <div class="token-info">
                        <i class="fa-solid fa-check-circle"></i>
                        <span>Token valideret</span>
                    </div>
                }

                <!-- New Password -->
                <div class="form-group">
                    <label>
                        <i class="fa-solid fa-lock"></i>
                        Ny adgangskode
                    </label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-key"></i>
                        <input asp-for="NewPassword" type="password" placeholder="Indtast ny adgangskode" />
                    </div>
                    <div class="password-requirements">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>Minimum 8 tegn, mindst ét tal og ét specialtegn</span>
                    </div>
                </div>

                <!-- Repeat Password -->
                <div class="form-group">
                    <label>
                        <i class="fa-solid fa-lock"></i>
                        Gentag adgangskode
                    </label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-key"></i>
                        <input asp-for="RepeatPassword" type="password" placeholder="Gentag ny adgangskode" />
                    </div>
                </div>

                <!-- 6-digit Code -->
                <div class="form-group">
                    <label>
                        <i class="fa-solid fa-hashtag"></i>
                        6-cifret kode
                    </label>
                    <div class="input-wrapper otp-wrapper">
                        <i class="fa-solid fa-circle-check"></i>
                        <input asp-for="OtpCode" maxlength="6" placeholder="123456" autocomplete="off inputmode="numeric" />
                    </div>
                    <div style="color: rgba(255,255,255,0.4); font-size: 0.75rem; margin-top: 0.25rem;">
                        Indtast den 6-cifrede kode fra din email
                    </div>
                </div>

                <!-- Error Message -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="error-message">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>Adgangskoderne matcher ikke, eller koden er ugyldig</span>
                    </div>
                }

                <!-- Submit Button -->
                <button type="submit" class="btn-confirm">
                    <i class="fa-solid fa-check-circle"></i>
                    Bekræft nulstilling
                </button>

                <!-- Security Info -->
                <div class="security-info">
                    <i class="fa-solid fa-clock"></i>
                    <span>Linket udløber om 30 minutter</span>
                </div>
            </form>
        </div>
    </div>

    <!-- Auto-focus on first field -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const firstInput = document.querySelector('input[name="NewPassword"]');
            if (firstInput) {
                firstInput.focus();
            }
        });
    </script>
</body>
</html>