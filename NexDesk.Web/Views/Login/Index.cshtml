@model NexDesk.Domain.Dtos.LoginDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>NexDesk Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/css/loginForm.css" />
    <link rel="stylesheet" href="~/css/feedbackToast.css" />
    <script src="~/js/feedbackToast.js"></script>
    <style>
        .role-toggle {
            position: relative;
            display: flex;
            background: rgba(255,255,255,0.07);
            border-radius: 999px;
            padding: 4px;
            margin: 0 auto 1rem;
            width: fit-content;
        }

        .role-btn {
            position: relative;
            z-index: 1;
            background: transparent;
            border: none;
            padding: 0.4rem 1.6rem;
            border-radius: 999px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.95rem;
            color: #888;
            transition: color 0.3s;
        }

            .role-btn.active {
                color: #fff;
            }

        .toggle-slider {
            position: absolute;
            top: 4px;
            left: 4px;
            height: calc(100% - 8px);
            width: calc(50% - 4px);
            background: #6366f1;
            border-radius: 999px;
            transition: transform 0.35s cubic-bezier(.4,0,.2,1);
            z-index: 0;
        }

            .toggle-slider.right {
                transform: translateX(100%);
            }

        .swipe-wrapper {
            display: flex;
            width: 100%;
            overflow: hidden;
        }

        .swipe-panel {
            min-width: 100%;
            transition: transform 0.4s cubic-bezier(.4,0,.2,1);
        }
    </style>
</head>
<body>
    <main class="auth-card" role="main" aria-labelledby="title">
        <div class="logo-wrap">
            <div class="logo">
                <img src="/img/nexdesk_logo_nobg.png" alt="NexDesk" />
            </div>
            <div class="brand">NexDesk</div>
        </div>

        <h1 id="title">Log ind</h1>

        <div class="role-toggle">
            <button type="button" class="role-btn active" id="btnSupport" onclick="switchRole('support')">Supporter</button>
            <button type="button" class="role-btn" id="btnAdmin" onclick="switchRole('admin')">Admin</button>
            <div class="toggle-slider" id="toggleSlider"></div>
        </div>

        <p class="lead" id="roleLabel">Log ind som Supporter</p>

        @* ── Add a hidden field to both forms to all swapping to stay intact ── *@

        <div class="swipe-wrapper" id="swipeWrapper">

            @* ── Support Panel (NO RFID) ── *@
            <div class="swipe-panel">
                <form asp-controller="Login" asp-action="Login" method="post" autocomplete="off" novalidate>
                    @Html.AntiForgeryToken()
                    
                    <div class="form-grid">
                        <div>
                            <label for="support_UserName">Brugernavn</label>
                            <input name="UserName" id="support_UserName" class="input"
                                   placeholder="Indtast dit brugernavn" autocomplete="username" required />
                        </div>
                        <div>
                            <label for="support_PassWord">Adgangskode</label>
                            <input name="PassWord" id="support_PassWord" class="input" type="password"
                                   placeholder="Indtast din adgangskode" autocomplete="current-password" required />
                        </div>
                        <div class="actions">
                            <span class="subtle">Brug for hjælp? Kontakt IT.</span>
                            <span class="subtle">Nexdesk2017@gmail.com</span>
                            <button class="btn" type="submit" id="loginBtnSupport">Bekræft</button>
                        </div>
                    </div>
                    <input type="hidden" name="SelectedRole" value="support" />
                </form>
            </div>

            @* ── Admin Panel (WITH RFID) ── *@
            <div class="swipe-panel">
                <form asp-controller="Login" asp-action="Login" method="post" autocomplete="off" novalidate>
                    @Html.AntiForgeryToken()
                   
                    <div class="form-grid">
                        @* If scanner fills it first: *@
                        <div>
                            <label for="RfidChip">RFID</label>
                            <input name="RfidChip" id="RfidChip" class="input" type="password"
                                   placeholder="Scan dit RFID" required />
                        </div>
                        <div>
                            <label for="admin_UserName">Brugernavn</label>
                            <input name="UserName" id="admin_UserName" class="input"
                                   placeholder="Indtast dit brugernavn" autocomplete="username" required />
                        </div>
                        <div>
                            <label for="admin_PassWord">Adgangskode</label>
                            <input name="PassWord" id="admin_PassWord" class="input" type="password"
                                   placeholder="Indtast din adgangskode" autocomplete="current-password" required />
                        </div>
                        <div class="actions">
                            <span class="subtle">Brug for hjælp? Kontakt IT.</span>
                            <button class="btn" type="submit" id="loginBtn">Bekræft</button>
                        </div>
                    </div>
                    <input type="hidden" name="SelectedRole" value="admin" />
                </form>
            </div>
           
        </div>

        <div class="footer">© 2025 NexDesk</div>

        @* Error messages except "3x attempts" *@
        @if (ViewData.ModelState.Values.Any(v => v.Errors.Any(e => !e.ErrorMessage.Contains("3x attempts"))))
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    if (!error.ErrorMessage.Contains("3x attempts"))
                    {
                        <p>@error.ErrorMessage</p>
                    }
                }
            </div>
        }

        @* Countdown *@
        @if (ViewData.ModelState.Values.Any(v => v.Errors.Any(e => e.ErrorMessage.Contains("3x attempts"))))
        {
            <div class="alert alert-danger">
                <p id="rateLimitMessage">⏳ For mange loginforsøg. Prøv igen om <span id="countdown">60</span> sekunder.</p>
            </div>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    ["support_UserName","support_PassWord","admin_UserName","admin_PassWord","RfidChip","loginBtn","loginBtnSupport"]
                        .forEach(id => { const el = document.getElementById(id); if (el) el.disabled = true; });

                    const countdownDisplay = document.getElementById("countdown");
                    let secondsLeft = 60;
                    const timer = setInterval(() => {
                        secondsLeft--;
                        countdownDisplay.textContent = secondsLeft;
                        if (secondsLeft <= 0) {
                            clearInterval(timer);
                            ["support_UserName","support_PassWord","admin_UserName","admin_PassWord","RfidChip","loginBtn","loginBtnSupport"]
                                .forEach(id => { const el = document.getElementById(id); if (el) el.disabled = false; });
                            document.getElementById("rateLimitMessage").textContent = "✅ Du kan prøve igen nu.";
                        }
                    }, 1000);
                });

              
            </script>
        }
        <div id="toastContainer"></div>

    </main>

    <script>
        let currentRole = 'support';

        function switchRole(role) {
            if (currentRole === role) return;
            currentRole = role;

            const panels = document.querySelectorAll('.swipe-panel');
            const slider = document.getElementById('toggleSlider');
            const label = document.getElementById('roleLabel');
            const btnSupport = document.getElementById('btnSupport');
            const btnAdmin = document.getElementById('btnAdmin');

            if (role === 'admin') {
                panels.forEach(p => p.style.transform = 'translateX(-100%)');
                slider.classList.add('right');
                btnAdmin.classList.add('active');
                btnSupport.classList.remove('active');
                label.textContent = 'Log ind som Admin';
                setTimeout(() => document.getElementById('RfidChip')?.focus(), 420);
            } else {
                panels.forEach(p => p.style.transform = 'translateX(0)');
                slider.classList.remove('right');
                btnSupport.classList.add('active');
                btnAdmin.classList.remove('active');
                label.textContent = 'Log ind som Supporter';
                setTimeout(() => document.getElementById('support_UserName')?.focus(), 420);
            }
        }

        // Restore tab after failed login

          // Persist the Admin  not reset, to swap  back to Support
                document.addEventListener("DOMContentLoaded", function () {
                    const role = '@(ViewData["SelectedRole"] ?? "support")';
                    if (role === 'admin') switchRole('admin');
                    // Console.WriteLine($"SelectedRole: '{model.SelectedRole}' | RFID: '{model.RfidChip}'");
                });


      
    </script>

    @* Feedback for success from Password Reset *@
    @if (TempData["SuccessMessage"] != null)
    {
        <link rel="stylesheet" href="~/css/feedbackToast.css" />
        <script src="~/js/feedbackToast.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                showToast('@TempData["SuccessMessage"]', 'success');
            });
        </script>
    }



</body>
</html>